# business-app — LOCAL (docker-compose.local.yml). One file for backend + BI.
# Gitignored. NODE_ENV / PORT / REDIS / BI_SERVICE_URL / *_BASE_URL /
# ALLOWED_ORIGINS / RELAY_API_URL / MONGO_DATABASE come from the compose.

# ── backend ──
# MongoDB is external (Atlas). Local dev MUST NOT share the production database.
# Prod uses `business_app_db`; local uses `business_app_db_dev` (same cluster is
# fine). Keep MONGO_DATABASE in docker-compose.local.yml in sync with this.
MONGODB_URI=CHANGE_ME_mongodb_uri
MONGODB_DB_NAME=business_app_db_dev
REDIS_PASSWORD=

JWT_ACCESS_SECRET=business-app-access-secret-replace-in-prod
JWT_REFRESH_SECRET=business-app-refresh-secret-replace-in-prod
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

PLATFORM_ADMIN_BOOTSTRAP_EMAIL=admin@invoiceapp.com
PLATFORM_ADMIN_BOOTSTRAP_PASSWORD=InvoiceApp123!
CREDENTIALS_MASTER_KEY_BASE64=CHANGE_ME

RELAY_ENVIRONMENT=development
RELAY_API_KEY=super-secret-key-123
BI_INTERNAL_SERVICE_TOKEN=CHANGE_ME

# ── business-intelligence (FastAPI) ──
# BI_DATABASE_URL is a separate (Postgres/Neon) warehouse — use a dev branch/db
# there too, it is unrelated to the Mongo split above.
# MONGO_URI is BI's read-only ETL source = the SAME cluster as MONGODB_URI above;
# the database it reads is MONGO_DATABASE (set in docker-compose.local.yml).
BI_DATABASE_URL=CHANGE_ME_postgres_url
MONGO_URI=CHANGE_ME_mongodb_uri
