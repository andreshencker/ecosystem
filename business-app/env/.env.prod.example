# business-app — PRODUCTION (docker-compose.prod.yml). One file for backend + BI.
# Gitignored. Public URLs / REDIS / BI_SERVICE_URL / RELAY_API_URL / MONGO_DATABASE
# come from the compose `environment:`.

# ── backend ──
MONGODB_URI=CHANGE_ME_mongodb_uri/business_app_db
MONGODB_DB_NAME=business_app_db
REDIS_PASSWORD=

JWT_ACCESS_SECRET=CHANGE_ME
JWT_REFRESH_SECRET=CHANGE_ME
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

PLATFORM_ADMIN_BOOTSTRAP_EMAIL=admin@grapifly.com
PLATFORM_ADMIN_BOOTSTRAP_PASSWORD=CHANGE_ME_strong_password
CREDENTIALS_MASTER_KEY_BASE64=CHANGE_ME

RELAY_ENVIRONMENT=production
# MUST match relay's RELAY_API_KEY
RELAY_API_KEY=CHANGE_ME
# MUST match the BI value below
BI_INTERNAL_SERVICE_TOKEN=CHANGE_ME

# ── business-intelligence (FastAPI) ──
BI_DATABASE_URL=CHANGE_ME_postgresql://user:pass@host/db?sslmode=require&channel_binding=require
MONGO_URI=CHANGE_ME_mongodb_uri/business_app_db
