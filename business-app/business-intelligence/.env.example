# Neon PostgreSQL connection URL (required)
# Format: postgresql://user:password@host/dbname?sslmode=require&channel_binding=require
BI_DATABASE_URL=

# Internal service token — must match BI_INTERNAL_SERVICE_TOKEN in business-app/.env
BI_INTERNAL_SERVICE_TOKEN=

PORT=8000

# MongoDB URI for ETL — reads from Business App's operational database
# Format: mongodb://user:pass@host:27017/business_app_db
MONGO_URI=

# MongoDB database name (default: business_app_db)
MONGO_DATABASE=business_app_db
