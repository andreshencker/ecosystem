NODE_ENV=development
PORT=3004

FRONTEND_BASE_URL=http://localhost:3005
APP_BASE_URL=http://localhost:3005
ALLOWED_ORIGINS=http://localhost:3005

MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<db>
MONGODB_DB_NAME=business_app_db

REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=

JWT_ACCESS_SECRET=<replace-with-strong-secret>
JWT_REFRESH_SECRET=<replace-with-strong-secret>
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

PLATFORM_ADMIN_BOOTSTRAP_EMAIL=admin@invoiceapp.com
PLATFORM_ADMIN_BOOTSTRAP_PASSWORD=<replace-with-strong-password>

# AES-256 key (32 bytes, base64): node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CREDENTIALS_MASTER_KEY_BASE64=<replace-with-generated-key>

# Communications App integration
# The remote companyId is resolved automatically from the Integration Token stored per company.
# No COMMUNICATION_COMPANY_ID is needed — each Business Company has its own CommunicationConnection.
COMMUNICATION_API_URL=http://localhost:3001
COMMUNICATION_ENVIRONMENT=development
