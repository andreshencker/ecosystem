# jtrade/backend/.env.prod  — copy to jtrade/backend/.env.prod and fill.
# CONTEXT_PATH, ALLOWED_ORIGINS, GRAPIFLY_FRONTEND_URL, FRONTEND_BASE_URL,
# JTRADE_PUBLIC_API_URL, GRAPIFLY_ID_API_URL, RELAY_API_URL are set in
# docker-compose.prod.yml. NOTE: jtrade's Dockerfile also COPYs this file into
# the image at build time, so it must be complete at build.

PORT=3002
NODE_ENV=prod

# jtrade uses an EXTERNAL / managed Mongo (no mongo service in the compose)
MONGODB_URI=

JWT_ACCESS_SECRET=
JWT_REFRESH_DAYS=7

# SSO — MUST equal grapifly's JTRADE_SERVICE_SECRET
JTRADE_SERVICE_SECRET=

GRAPIFLY_APP_CONFIG_CACHE_SECONDS=15

# Relay — MUST equal relay's RELAY_API_KEY
RELAY_API_KEY=
RELAY_GRAPIFLY_COMPANY_ID=
