# grapifly/.env.prod  — copy to grapifly/.env.prod (grapifly reads its env from
# the app root, not backend/) and fill.
# Public URLs / NODE_ENV / MONGODB_URI are already set in docker-compose.prod.yml
# and override anything here, so this file only needs secrets + emails.

# Sessions
JWT_SESSION_SECRET=

# Google OAuth (console.cloud.google.com → Credentials → OAuth client)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Service-to-service SSO secrets. Each one MUST equal the value the matching
# app uses (relay: RELAY_SERVICE_SECRET or GRAPIFLY_SSO_CLIENT_SECRET;
# jtrade: JTRADE_SERVICE_SECRET). Generate: openssl rand -hex 32
GRAPIFLY_SERVICE_SECRET=
RELAY_SERVICE_SECRET=
BUSINESS_SERVICE_SECRET=
JTRADE_SERVICE_SECRET=

# Legacy shared secret relay still falls back to — set = RELAY_SERVICE_SECRET.
GRAPIFLY_SSO_CLIENT_SECRET=

# Bootstrap access
ECOSYSTEM_SUPER_ADMIN_EMAIL=grapiflydeveloper@gmail.com
RELAY_INITIAL_ACCESS_EMAILS=grapiflydeveloper@gmail.com,andreshenckerq@gmail.com

# Only if you do NOT want the compose default mongodb://mongo:27017/grapifly_identity
# MONGODB_URI=
