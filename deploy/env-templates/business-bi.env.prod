# business-app/business-intelligence/.env.prod  — copy to
# business-app/business-intelligence/.env.prod and fill.
# PORT and MONGO_DATABASE are set in docker-compose.prod.yml.

# Neon PostgreSQL (asyncpg): postgresql://user:pass@host/db?sslmode=require&channel_binding=require
BI_DATABASE_URL=

# MUST equal business backend's BI_INTERNAL_SERVICE_TOKEN
BI_INTERNAL_SERVICE_TOKEN=

# Business App MongoDB (read-only, for ETL)
MONGO_URI=
