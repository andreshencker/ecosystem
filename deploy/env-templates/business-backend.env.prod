# business-app/backend/.env.prod  — copy to business-app/backend/.env.prod and fill.
# NODE_ENV, PORT, REDIS_HOST/PORT, BI_SERVICE_URL, FRONTEND_BASE_URL,
# APP_BASE_URL, ALLOWED_ORIGINS, RELAY_API_URL are set in docker-compose.prod.yml.

# MongoDB — database business_app_db
MONGODB_URI=
MONGODB_DB_NAME=business_app_db

REDIS_PASSWORD=

# JWT — node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# First platform admin, created on boot
PLATFORM_ADMIN_BOOTSTRAP_EMAIL=admin@grapifly.com
PLATFORM_ADMIN_BOOTSTRAP_PASSWORD=

# AES-256 key, base64 (32 bytes):
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CREDENTIALS_MASTER_KEY_BASE64=

# Shared secret with the BI service — MUST equal BI's BI_INTERNAL_SERVICE_TOKEN
BI_INTERNAL_SERVICE_TOKEN=

# Relay — MUST equal relay's RELAY_API_KEY
RELAY_API_KEY=
RELAY_ENVIRONMENT=production
