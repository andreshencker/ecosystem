# relay/backend/.env.prod  — copy to relay/backend/.env.prod and fill.
# NODE_ENV, PORT, REDIS_HOST/PORT, APP_BASE_URL, API_BASE_URL, ALLOWED_ORIGINS,
# GRAPIFLY_ID_API_URL and the OAuth return URLs are set in docker-compose.prod.yml.

# MongoDB — database MUST be named communication_platform_db
MONGODB_URI=

# Internal admin key protecting engine endpoints (also used by jtrade + business)
RELAY_API_KEY=

# Grapifly service-to-service trust — set = grapifly's RELAY_SERVICE_SECRET
RELAY_SERVICE_SECRET=
GRAPIFLY_SSO_CLIENT_SECRET=

# AES-256-GCM master key, base64 (32 bytes):
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CREDENTIALS_MASTER_KEY_BASE64=

# JWT — node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Redis (container has no password unless you set one)
REDIS_PASSWORD=

# AWS / S3 (media storage)
AWS_REGION=
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
MEDIA_PUBLIC_BASE_URL=

# Platform SMTP (registration / verification / password-reset emails)
PLATFORM_SMTP_HOST=
PLATFORM_SMTP_PORT=587
PLATFORM_SMTP_SECURE=false
PLATFORM_SMTP_USER=
PLATFORM_SMTP_PASS=
PLATFORM_SMTP_FROM_EMAIL=
PLATFORM_SMTP_FROM_NAME=Relay

ALLOW_DEBUG_DECRYPTED=false
