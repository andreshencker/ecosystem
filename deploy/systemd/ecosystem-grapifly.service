[Unit]
Description=Ecosystem - grapifly (grapifly.com, id.grapifly.com)
Requires=docker.service
After=docker.service network-online.target
PartOf=ecosystem.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=__ECOSYSTEM_ROOT__/grapifly
ExecStart=/usr/bin/docker compose -f docker-compose.prod.yml up -d
ExecStop=/usr/bin/docker compose -f docker-compose.prod.yml down
TimeoutStartSec=0

[Install]
WantedBy=ecosystem.target
