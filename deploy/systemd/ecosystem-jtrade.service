[Unit]
Description=Ecosystem - jtrade (jtrade.grapifly.com)
Requires=docker.service
After=docker.service network-online.target ecosystem-grapifly.service ecosystem-relay.service
PartOf=ecosystem.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=__ECOSYSTEM_ROOT__/jtrade
ExecStart=/usr/bin/docker compose -f docker-compose.prod.yml up -d
ExecStop=/usr/bin/docker compose -f docker-compose.prod.yml down
TimeoutStartSec=0

[Install]
WantedBy=ecosystem.target
