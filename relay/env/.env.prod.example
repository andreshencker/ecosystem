# relay — PRODUCTION (docker-compose.prod.yml). Committed template — cp to .env.prod, then replace every CHANGE_ME_*
# NODE_ENV / PORT / REDIS / *_BASE_URL / ALLOWED_ORIGINS / GRAPIFLY_ID_API_URL
# / OAuth return URLs come from the compose `environment:`.

# MongoDB — database MUST be communication_platform_db.
MONGODB_URI=CHANGE_ME_mongodb_uri/communication_platform_db

RELAY_API_KEY=c34a980f102f6f5a8c164ad3aeb952c0f09cb0ae6d0f4ae5
RELAY_SERVICE_SECRET=a0b19dc86c8d8b6df87220c6f83e5325e3838570edb38ff8859a8df7ba5a287c
GRAPIFLY_SSO_CLIENT_SECRET=a0b19dc86c8d8b6df87220c6f83e5325e3838570edb38ff8859a8df7ba5a287c

CREDENTIALS_MASTER_KEY_BASE64=VwqDb07FqUB+hDzW5rF55awHLD8SmoCBItM1kGCgxZc=
JWT_ACCESS_SECRET=02682d5dd8edc6c32b8c9ea08f7c4a8f8d906dce6d37bb3a90b0a98eef96630f
JWT_REFRESH_SECRET=035a823f496f444cc6b7d930070ccc1a9eac2ac97c235bbfa4adcef42968d786
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

REDIS_PASSWORD=

# AWS / S3 (media storage)
AWS_REGION=ap-southeast-2
AWS_S3_BUCKET=CHANGE_ME_bucket
AWS_ACCESS_KEY_ID=CHANGE_ME_aws_key
AWS_SECRET_ACCESS_KEY=CHANGE_ME_aws_secret
MEDIA_PUBLIC_BASE_URL=CHANGE_ME_https://<bucket>.s3.<region>.amazonaws.com
MEDIA_MAX_MB=5

# Platform SMTP (registration / verification / password-reset emails)
PLATFORM_SMTP_HOST=CHANGE_ME_smtp_host
PLATFORM_SMTP_PORT=587
PLATFORM_SMTP_SECURE=false
PLATFORM_SMTP_USER=CHANGE_ME_smtp_user
PLATFORM_SMTP_PASS=CHANGE_ME_smtp_pass
PLATFORM_SMTP_FROM_EMAIL=noreply@grapifly.com
PLATFORM_SMTP_FROM_NAME=Relay

PUPPETEER_MAX_CONCURRENT=3
QUEUE_NOTIFICATION_CONCURRENCY=5
QUEUE_FILE_GENERATION_CONCURRENCY=3
ALLOW_DEBUG_DECRYPTED=false
