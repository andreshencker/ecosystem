# relay — LOCAL (docker-compose.local.yml). Gitignored.
# NODE_ENV / PORT / REDIS_HOST / *_BASE_URL / ALLOWED_ORIGINS / GRAPIFLY_ID_API_URL
# come from the compose `environment:` block.

# MongoDB is external (Atlas). Local dev MUST NOT share the production database.
# Relay's db name is NOT taken from the URI path — set it explicitly below.
# Prod uses `relaydb`; local uses `relaydb_dev` (same cluster is fine).
MONGODB_URI=CHANGE_ME_mongodb_uri
MONGODB_DB_NAME=relaydb_dev

RELAY_API_KEY=super-secret-key-123
CREDENTIALS_MASTER_KEY_BASE64=CHANGE_ME
RELAY_SERVICE_SECRET=development-grapifly-relay-sso-change-me

AWS_REGION=ap-southeast-2
AWS_S3_BUCKET=jtrade-media
AWS_ACCESS_KEY_ID=CHANGE_ME
AWS_SECRET_ACCESS_KEY=CHANGE_ME
MEDIA_PUBLIC_BASE_URL=https://jtrade-media.s3.ap-southeast-2.amazonaws.com
MEDIA_MAX_MB=5

REDIS_PASSWORD=

JWT_ACCESS_SECRET=phase1a-placeholder-must-replace-in-phase1b
JWT_REFRESH_SECRET=phase1a-placeholder-refresh-must-replace
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

PLATFORM_SMTP_HOST=
PLATFORM_SMTP_PORT=587
PLATFORM_SMTP_SECURE=false
PLATFORM_SMTP_USER=
PLATFORM_SMTP_PASS=
PLATFORM_SMTP_FROM_EMAIL=noreply@communicationplatform.com
PLATFORM_SMTP_FROM_NAME=Communication Platform

PUPPETEER_MAX_CONCURRENT=3
QUEUE_NOTIFICATION_CONCURRENCY=5
QUEUE_FILE_GENERATION_CONCURRENCY=3
ALLOW_DEBUG_DECRYPTED=false

XERO_OAUTH_FRONTEND_RETURN_URL=http://localhost:3000/provider-credentials
GOOGLE_EMAIL_OAUTH_FRONTEND_RETURN_URL=http://localhost:3000/provider-credentials
