PORT=3101
# One origin or a comma-separated list (CORS + browser redirects).
# prod: https://grapifly.com
FRONTEND_URL=http://localhost:3100
MONGODB_URI=mongodb://localhost:27017/grapiflydb
JWT_SESSION_SECRET=replace-with-a-long-random-secret

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match an Authorized redirect URI in Google Cloud Console.
# prod: https://id.grapifly.com/auth/google/callback
GOOGLE_CALLBACK_URL=http://localhost:3101/auth/google/callback

ECOSYSTEM_SUPER_ADMIN_EMAIL=grapiflydeveloper@gmail.com
RELAY_INITIAL_ACCESS_EMAILS=grapiflydeveloper@gmail.com,grapiflytrading@gmail.com,grapiflyvideo@gmail.com,andreshenckerq@gmail.com

# ── Per-app public URLs (written into the applications catalogue on boot) ──
# The "My Apps" launcher and post-logout redirects use these. Leave unset for
# local dev (falls back to localhost).
# GRAPIFLY_APP_URL=https://grapifly.com
# RELAY_APP_URL=https://relay.grapifly.com
# BUSINESS_APP_URL=https://businessapp.grapifly.com
# JTRADE_APP_URL=https://jtrade.grapifly.com

# ── SSO callback URLs (each app's /auth/grapifly/callback) ──
# RELAY_SSO_CALLBACK_URL=https://relay.grapifly.com/auth/grapifly/callback
# JTRADE_SSO_CALLBACK_URL=https://jtrade.grapifly.com/auth/grapifly/callback

# ── Per-app service secrets (SSO exchange). Fallback: development-<app>-service-secret-change-me ──
# GRAPIFLY_SERVICE_SECRET=
# RELAY_SERVICE_SECRET=
# BUSINESS_SERVICE_SECRET=
# JTRADE_SERVICE_SECRET=
