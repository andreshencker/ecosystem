# grapifly — PRODUCTION (docker-compose.prod.yml). Committed template — cp to .env.prod, then replace every CHANGE_ME_*
# Public URLs / SSO callbacks come from the compose `environment:`.
# CHANGE_ME_* = you must fill it. Generated secrets below are fine to keep but rotate if leaked.

# MongoDB is external (Atlas). Database: grapiflydb.
MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/grapiflydb

JWT_SESSION_SECRET=a538d04225612d3808d359e7a139fc043f94b0a05972b8a6d6a6c8f94bbe8254a

# Google OAuth — from console.cloud.google.com (reuse the current dev client or make a prod one).
GOOGLE_CLIENT_ID=30220002402-08k9ct7h1riidk4sic70n9s7njjk975n.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=CHANGE_ME_google_client_secret

# Service-to-service SSO secrets — each MUST match the same value in the target app.
GRAPIFLY_SERVICE_SECRET=9e820c73c9f72463ec8ff6302003db6fd161cd8834364ef133a321448cf84f5d
RELAY_SERVICE_SECRET=a0b19dc86c8d8b6df87220c6f83e5325e3838570edb38ff8859a8df7ba5a287c
BUSINESS_SERVICE_SECRET=954f017ae817ccbc4295b9cbef94dd7fc582a9014c911eb9d543eb463d657e2c
JTRADE_SERVICE_SECRET=6593b87e50549635759682514630a7e97cb59c42a5b51d147089c2edeaeea695

# Legacy shared secret relay falls back to — keep = RELAY_SERVICE_SECRET.
GRAPIFLY_SSO_CLIENT_SECRET=a0b19dc86c8d8b6df87220c6f83e5325e3838570edb38ff8859a8df7ba5a287c

ECOSYSTEM_SUPER_ADMIN_EMAIL=grapiflydeveloper@gmail.com
RELAY_INITIAL_ACCESS_EMAILS=grapiflydeveloper@gmail.com,andreshenckerq@gmail.com
