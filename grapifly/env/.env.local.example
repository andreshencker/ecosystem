# grapifly — LOCAL (docker-compose.local.yml). Gitignored.
# PORT / SSO callbacks come from the compose `environment:` block.

# MongoDB is external (Atlas). Local dev MUST use a database that is NOT the
# production one — prod uses `grapiflydb`, so local uses `grapiflydb_dev`
# (same cluster is fine; the database name is what keeps the environments apart).
MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/grapiflydb_dev

FRONTEND_URL=http://localhost:3100
JWT_SESSION_SECRET=dev-jwt-session-secret-change-me

GOOGLE_CLIENT_ID=30220002402-08k9ct7h1riidk4sic70n9s7njjk975n.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=CHANGE_ME
GOOGLE_CALLBACK_URL=http://localhost:3101/auth/google/callback

GRAPIFLY_SSO_CLIENT_SECRET=development-grapifly-relay-sso-change-me
RELAY_API_URL=http://host.docker.internal:3001

ECOSYSTEM_SUPER_ADMIN_EMAIL=grapiflydeveloper@gmail.com
RELAY_INITIAL_ACCESS_EMAILS=grapiflydeveloper@gmail.com,grapiflytrading@gmail.com,grapiflyvideo@gmail.com,andreshenckerq@gmail.com
