# jtrade — LOCAL (docker-compose.local.yml, backend service). Gitignored.
# CONTEXT_PATH / GRAPIFLY_* / RELAY_API_URL / FRONTEND_BASE_URL
# come from the compose `environment:` block.

PORT=3002
# MongoDB is external (Atlas). Local dev MUST use its own database, not prod's:
# prod uses `jtradedb`, local uses `jtradedb_dev` (same cluster is fine — the
# database name is what keeps local and prod apart).
MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/jtradedb_dev
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_DAYS=7

JTRADE_SERVICE_SECRET=development-jtrade-service-secret-change-me
GRAPIFLY_APP_CONFIG_CACHE_SECONDS=15

RELAY_API_KEY=super-secret-key-123
# Relay Company _id for the Grapifly platform org, as stored in Relay's DB.
# This is per-database: after first seeding a fresh `relaydb_dev`, replace this
# with the _id from `relaydb_dev.companies.findOne({ isPlatformCompany: true })`.
RELAY_GRAPIFLY_COMPANY_ID=6a3a6556ab34cce605d91422
