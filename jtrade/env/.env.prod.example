# jtrade — PRODUCTION (docker-compose.prod.yml, backend service). Gitignored.
# CONTEXT_PATH / ALLOWED_ORIGINS / GRAPIFLY_* / RELAY_API_URL / FRONTEND_BASE_URL
# / JTRADE_PUBLIC_API_URL come from the compose `environment:`.

PORT=3002
NODE_ENV=prod

# jtrade uses an EXTERNAL / managed Mongo (no mongo service in its compose).
MONGODB_URI=CHANGE_ME_mongodb_uri/jtrade

JWT_ACCESS_SECRET=CHANGE_ME
JWT_REFRESH_DAYS=7

# MUST match grapifly's JTRADE_SERVICE_SECRET
JTRADE_SERVICE_SECRET=CHANGE_ME
GRAPIFLY_APP_CONFIG_CACHE_SECONDS=15

# MUST match relay's RELAY_API_KEY
RELAY_API_KEY=CHANGE_ME
RELAY_GRAPIFLY_COMPANY_ID=6a3a6556ab34cce605d91422
