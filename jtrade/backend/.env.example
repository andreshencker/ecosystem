PORT=3002
CONTEXT_PATH=/backend
MONGODB_URI=mongodb://localhost:27017/jtrade
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_DAYS=7

# Extra CORS origins on top of the localhost dev defaults (comma-separated).
# prod: https://jtrade.grapifly.com
# ALLOWED_ORIGINS=

# Grapifly ecosystem integration
GRAPIFLY_ID_API_URL=http://localhost:3101
GRAPIFLY_FRONTEND_URL=http://localhost:3100
JTRADE_SERVICE_SECRET=development-jtrade-service-secret-change-me
GRAPIFLY_APP_CONFIG_CACHE_SECONDS=15

# Relay integration (platforms catalogue + logo storage)
RELAY_API_URL=http://localhost:3001
RELAY_API_KEY=replace-with-relays-RELAY_API_KEY
RELAY_GRAPIFLY_COMPANY_ID=replace-with-grapifly-platform-company-id

# Browser application
FRONTEND_BASE_URL=http://localhost:5173

# Public base URL of this backend (incl. context path) — used to build indicator webhook URLs
JTRADE_PUBLIC_API_URL=http://localhost:3002/backend
