# ─────────────────────────────────────────────────────────────────────────────
# COMMUNICATION PLATFORM — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to the repository.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Application ─────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001

# Public base URL of the frontend — used in email links and UI navigation.
# Must point to the frontend (Next.js), not the API port.
APP_BASE_URL=http://localhost:3000

# Public base URL of this API — used for backend callback URLs (e.g. OAuth).
# Must point to the NestJS server port.
API_BASE_URL=http://localhost:3001

# Comma-separated list of allowed CORS origins (e.g. https://dashboard.example.com)
ALLOWED_ORIGINS=http://localhost:3000

# ─── MongoDB ─────────────────────────────────────────────────────────────────
# The database MUST be named communication_platform_db
# Example: mongodb+srv://user:pass@cluster.mongodb.net/communication_platform_db
MONGODB_URI=

# ─── Internal API Key (communication engine) ─────────────────────────────────
# Used to protect internal communication engine endpoints.
# Rotate this key and keep it secret — never expose it to external clients.
COMMUNICATION_API_KEY=

# ─── Credentials Encryption ──────────────────────────────────────────────────
# AES-256-GCM master key encoded as base64.
# Must decode to exactly 32 bytes.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CREDENTIALS_MASTER_KEY_BASE64=

# ─── AWS / S3 ────────────────────────────────────────────────────────────────
AWS_REGION=
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
MEDIA_PUBLIC_BASE_URL=
MEDIA_MAX_MB=5

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
# Leave blank if Redis has no password
REDIS_PASSWORD=

# ─── JWT (Phase 1 — not yet in use) ─────────────────────────────────────────
# Generate secrets with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Platform SMTP ───────────────────────────────────────────────────────────
# Used ONLY for platform-level emails (registration, verification, password reset).
# This is NOT the tenant's email provider — it is the platform operator's SMTP.
PLATFORM_SMTP_HOST=
PLATFORM_SMTP_PORT=587
PLATFORM_SMTP_SECURE=false
PLATFORM_SMTP_USER=
PLATFORM_SMTP_PASS=
PLATFORM_SMTP_FROM_EMAIL=
PLATFORM_SMTP_FROM_NAME=Communication Platform

# ─── Channel Timeout ─────────────────────────────────────────────────────────
# Maximum time in milliseconds for a single channel send operation (SMTP, Twilio, etc.)
# before it is abandoned and returns { success: false, error: "Provider timeout" }.
# Must be > 0. Applies to all channel implementations.
CHANNEL_TIMEOUT_MS=10000

# ─── Puppeteer ───────────────────────────────────────────────────────────────
# Maximum number of concurrent headless browser instances for PDF generation.
PUPPETEER_MAX_CONCURRENT=3

# ─── Queue ───────────────────────────────────────────────────────────────────
QUEUE_NOTIFICATION_CONCURRENCY=5
QUEUE_FILE_GENERATION_CONCURRENCY=3

# ─── Debug / Feature Flags ───────────────────────────────────────────────────
# Must be false in production. Debug endpoint has been removed entirely.
ALLOW_DEBUG_DECRYPTED=false

# ─── Xero OAuth 2.0 ──────────────────────────────────────────────────────────
# Each company supplies their own Xero OAuth app credentials (clientId +
# clientSecret). Those are stored per-company in ProviderCredentials (encrypted).
#
# These env vars control the *platform-level* OAuth flow configuration:
#
# XERO_OAUTH_FRONTEND_RETURN_URL
#   The URL the browser is redirected to after a Xero OAuth callback completes
#   (success, error, or tenant-selection). Must be the frontend page that
#   handles the ?status= query parameter.
#   Default: http://localhost:3000/accounting/connections
XERO_OAUTH_FRONTEND_RETURN_URL=http://localhost:3000/provider-credentials
#
# XERO_OAUTH_SCOPES (optional override)
#   Space-separated list of Xero OAuth scopes to request.
#   Default is derived from the implemented Banking capability (granular model):
#     accounting.reports.banksummary.read accounting.settings.read offline_access openid
#   Only override if your Xero app requires additional implemented capabilities.
#   Do NOT use legacy broad scopes (accounting.reports.read etc.) — new app registrations reject them.
# XERO_OAUTH_SCOPES=accounting.reports.banksummary.read accounting.settings.read offline_access openid
#
# Xero callback URL (not a secret — registered in the Xero developer portal):
#   {API_BASE_URL}/accounting/oauth/xero/callback
#   e.g. https://api.yourdomain.com/accounting/oauth/xero/callback
